# Local/dev configuration. Copy to .env and fill in; never commit the real .env.

# Path to the SQLite file. Left unset locally (defaults next to pipeline.py).
# In the deployed Container Apps Job this will point at the mounted Azure
# Files share, e.g. /data/pipeline.db.
DB_PATH=

# Microsoft Graph mail-send. Required to send the digest email; if any of
# these are unset, the digest is still built and logged, just not sent.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_MAILBOX=
GRAPH_DIGEST_RECIPIENT=
